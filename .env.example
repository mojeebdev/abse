# Public Base44 project identifier. Never place secrets in VITE_* variables.
VITE_BASE44_APP_ID=

# Development fixtures are available only when Vite is running in development.
# Production builds ignore this flag unless it is explicitly wired by a developer.
VITE_ABSE_DEMO_MODE=false

# The hackathon build uses public GitHub username import instead of an app-user connector.
# Visitors enter a public GitHub username and Abse analyzes public profile data only.
